# Copy to .env (git-ignored). The teacher is any OpenAI-compatible chat endpoint.
# Any OpenAI-compatible endpoint serving the teacher (we used vLLM behind a LiteLLM gateway).
TEACHER_BASE_URL=http://localhost:4000/v1
TEACHER_API_KEY=sk-...
# rande-fast-local   = nvidia/Gemma-4-26B-A4B-NVFP4        (general, multilingual)
# rande-strong-local = ucbye/Qwen3-Coder-Next-NVFP4-GB10   (coder)
TEACHER_MODEL=rande-fast-local
